  "github": {
    "owner": "braedensc",
    "repo": "todoclaw",
    "defaultBranch": "main"
  },

  "branch": {
    "types": ["feat", "fix", "chore", "refactor", "docs"],
    "requireTicketId": true
  },

  "stack": {
    "kind": "node-ts",
    "securityNotes": [
      "All AI calls run server-side in Supabase Edge Functions (Deno runtime); the Anthropic key is never in the frontend bundle.",
      "The Supabase service role key is server-only and must never appear in a frontend file or client bundle. service_role has no table DML — writes go through SECURITY DEFINER RPCs.",
      "RLS on every table (user_id = auth.uid()). No raw SQL — Supabase query builder only. Zod validates every boundary.",
      "RLS is a who check, not a how much check: every user-writable table needs a per-user row cap trigger and a size CHECK on unbounded text/jsonb columns.",
      "A SECURITY DEFINER function granted to authenticated must scope its writes to auth.uid() — it bypasses the RLS of the tables it writes.",
      "The entire planner must work without AI; AI is additive, never required."
    ],
    "graderPaths": [
      "supabase/migrations/**",
      "supabase/functions/**",
      "src/lib/**",
      "scripts/check-*.mjs",
      "evals/**",
      ".claude/hooks/**"
    ]
  },

  "commands": {
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm test",
    "e2e": "npm run test:e2e",
    "preview": "npm run dev"
  },

  "budgets": {
    "perEffort": {
      "S": { "maxTurns": 60, "maxUsd": 6.0, "maxMinutes": 60 },
      "M": { "maxTurns": 150, "maxUsd": 20.0, "maxMinutes": 180 },
      "L": { "maxTurns": 400, "maxUsd": 45.0, "maxMinutes": 480 }
    },
    "maxTurns": 500,
    "wipLimit": 3,
    "maxBounces": 3,
    "fixIterations": 5,
    "totalAttempts": 3,
    "dailyUsd": 50.0,
    "reviewSeverityThreshold": "medium"
  },

  "auth": {
    "devSessions": "subscription",
    "scheduled": "api-key",
    "review": "api-key"
  },

  "autonomy": {
    "autoApproveProvenance": ["epic"],
    "autoMergeMaxLines": 0,
    "autoMergeMethod": "squash",
    "riskPaths": [
      ".claude/hooks/**",
      ".claude/settings*.json",
      ".claude/skills/**",
      ".github/workflows/**",
      ".husky/**",
      "delivery.json",
      "**/*.pem",
      "**/*.key"
    ]
  },

  "dispatch": {
    "backend": "local-daemon",
    "labelTrigger": "agent:queued",
    "pauseOnCapacity": true,
    "pinsRoot": "~/.claude/pipeline/pins",
    "statePath": "~/.claude/pipeline/state.json"
  },

  "monitoring": {
    "provider": "github-actions",
    "stormPerHour": 6
  }
